{
  "S1": {
    "titles": {
      "S": "S1: Data Models and File Parsing"
    },
    "input": [
      [
        "a",
        "VCDS installed files (Codes.dat, AutoScan.txt, .rod, .lbl, .SCL, .cfg)"
      ],
      [
        "b",
        "Ghidra decompilation output (reference for binary formats)"
      ]
    ],
    "process": [
      [
        "p1",
        "Parse each file format and validate against known structure"
      ],
      [
        "p2",
        "Convert to JSON/YAML canonical format in data/ directory"
      ],
      [
        "p3",
        "Verify round-trip: parsed JSON values match original binary/text"
      ]
    ],
    "output": [
      [
        "o1",
        "`data/codes.json`"
      ],
      [
        "o2",
        "`data/autoscan.json`"
      ],
      [
        "o3",
        "`data/modules.json` (from .rod files)"
      ],
      [
        "o4",
        "`data/labels.json` (from .lbl files)"
      ],
      [
        "o5",
        "`data/scales.json` (from .SCL files)"
      ]
    ],
    "edges": "a>p1 p1>o1 b>p2 p2>o2 a>p3 p3>o3 b>p1 p1>o4 a>p2 p2>o5"
  },
