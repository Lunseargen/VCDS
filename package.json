{
  "name": "vcds-rebuild",
  "version": "1.0.0",
  "description": "VCDS rebuild - TypeScript + Electron cross-platform VAG diagnostic tool",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "start": "electron .",
    "dev": "tsc --watch & electron .",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck:ui": "tsc -p ui/tsconfig.json"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "node-hid": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^3.0.0"
  },
  "author": "",
  "license": "MIT"
}
